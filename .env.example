# Required
JWT_SECRET=generate-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local HTTPS (https://localhost:3000) — npm run https:cert then:
# HTTPS=true
# HTTPS_KEY_PATH=certs/localhost-key.pem
# HTTPS_CERT_PATH=certs/localhost-cert.pem

# Recommended on Railway
NODE_ENV=production
APP_URL=https://your-app.example.com
WEBHOOK_VERIFY_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Facebook / Instagram OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://your-app.up.railway.app/auth/facebook/callback
# Instagram Login (NOT the Facebook App ID — copy from Instagram → Business login settings)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-app.up.railway.app/auth/instagram/callback

# TikTok OAuth (Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Aliases (optional): TIKTOK_APP_ID / TIKTOK_APP_SECRET
TIKTOK_REDIRECT_URI=https://your-api.example.com/auth/tiktok/callback
# Must match scopes enabled on the TikTok app.
# comment.list → GET /api/tiktok/comments ; video.list → GET /api/tiktok/videos
TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,video.list,comment.list,biz.brand.insights

# Personal Telegram account (MTProto — https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Set to false to disable GramJS NewMessage listeners on startup
TELEGRAM_LISTENER_ENABLED=true
# Instagram webhook events worker (processes rows from webhook_events table)
WEBHOOK_EVENTS_WORKER_ENABLED=true
# Max events processed in parallel per poll
WEBHOOK_EVENTS_WORKER_CONCURRENCY=4
# Idle wait when no pending events (ms)
WEBHOOK_EVENTS_WORKER_POLL_INTERVAL_MS=1000
# Failed events are retried until attempts reach this limit
WEBHOOK_EVENTS_WORKER_MAX_ATTEMPTS=5

# Instagram history sync worker (conversations + messages for last 7 days after connect)
INSTAGRAM_SYNC_WORKER_ENABLED=true
INSTAGRAM_SYNC_WORKER_POLL_INTERVAL_MS=2000

# Optional
SWAGGER_ENABLED=false
DB_SSL=true
OPENAI_API_KEY=
CF_ACCOUNT_ID=
CF_API_KEY=
# Cloudflare R2 (S3-compatible) — video/audio from Telegram & Instagram conversations
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=
# Public base URL (custom domain or https://pub-xxx.r2.dev)
CF_R2_PUBLIC_URL=

# SendGrid (dynamic template emails)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Registration confirmation template variables: first_name, company_name, confirm_url
SENDGRID_REGISTRATION_TEMPLATE_ID=
# Password reset template variables: first_name, email, reset_url, expires_in, logo_url, support_email
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=
SUPPORT_EMAIL=support@multisale.com
EMAIL_LOGO_URL=
PASSWORD_RESET_EXPIRES_LABEL=30 хвилин
# Invitation template variables: name, invitationLink

# MonoPay (Plata by mono) — manual one-time payments, no auto-renew
#
# IMPORTANT: use Merchant Acquiring X-Token from https://web.monobank.ua/
#   → Інтернет → Еквайринг → Токен
# NOT the Personal API token from https://api.monobank.ua/index.html
#
# This server uses Acquiring API (X-Token header):
#   POST /api/merchant/invoice/create
#   GET  /api/merchant/invoice/status
# OAuth Checkout API (client_id/secret) is NOT implemented.
MONOPAY_MERCHANT_TOKEN=
# Aliases (optional, lower priority):
# MONOPAY_TOKEN=
# MONOBANK_MERCHANT_TOKEN=
# MONOBANK_TOKEN=
#
# Public HTTPS URL of this API (for webhook derivation)
PUBLIC_API_URL=https://your-api.example.com
# Optional overrides:
# MONOPAY_API_BASE_URL=https://api.monobank.ua
# MONOPAY_WEBHOOK_URL=https://your-api.example.com/webhooks/monopay
# MONOPAY_REDIRECT_URL=https://your-app.example.com/billing/payment/result
# MONOPAY_INVOICE_VALIDITY_SEC=3600
# APP_URL=https://your-app.example.com
#
# Not used (webhooks verified via X-Sign ECDSA, not shared secret):
# MONOPAY_CLIENT_ID=
# MONOPAY_CLIENT_SECRET=
# MONOPAY_WEBHOOK_SECRET=
